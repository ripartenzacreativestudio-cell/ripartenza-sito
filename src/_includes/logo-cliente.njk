<img class="on-light" src="{{ c.logo }}" alt="{{ c.nome }}" loading="lazy" decoding="async" style="width:calc({{ c.larghezza_logo or 100 }}px * 1.15)">{% if c.logo_scuro %}<img class="on-dark" src="{{ c.logo_scuro }}" alt="" aria-hidden="true" loading="lazy" decoding="async" style="width:calc({{ c.larghezza_logo or 100 }}px * 1.15)">{% endif %}
